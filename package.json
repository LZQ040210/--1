{
  "name": "mcp-openclaw-devstudio",
  "version": "0.1.0",
  "description": "MCP & OpenClaw Low-Code Development Platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w packages/core-engine && npm run build -w packages/mcp-server-builder && npm run build -w apps/web",
    "test": "npm run test --workspaces",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "keywords": [
    "MCP",
    "Model Context Protocol",
    "OpenClaw",
    "AI Agent",
    "Low-Code",
    "Developer Tools"
  ],
  "author": "Tencent AI DevTeam",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0"
  }
}
